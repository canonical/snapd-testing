#!/usr/bin/python3

import requests
import argparse
import json

def handle_train(base_url, port):
    url = f"{base_url.rstrip('/')}:{port}/train"
    print(f"Triggering training at {url}...")
    
    try:
        # We use a slightly longer timeout than the server's internal proxy
        response = requests.post(url, timeout=10)
        
        if response.status_code in [200, 202]:
            print(f"{response.json().get('message', 'Training started.')}")
        elif response.status_code == 429:
            print("Busy: A training session is already in progress.")
        else:
            print(f"error ({response.status_code}): {response.text}")
            
    except requests.exceptions.RequestException as e:
        print(f"Failed to reach the trainer API: {e}")

def handle_status(base_url, port):
    url = f"{base_url.rstrip('/')}:{port}/status"
    
    try:
        response = requests.get(url, timeout=5)
        if response.status_code == 200:
            status_data = response.json()
            # Pretty print the status JSON
            print("Current Trainer Status:")
            print(json.dumps(status_data, indent=4))
        else:
            print(f"Could not retrieve status ({response.status_code})")
    except Exception as e:
        print(f"Error: {e}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Control the Model Trainer Service.")
    parser.add_argument("--url", default="http://test-predictor.canonical.com", help="Base URL")
    parser.add_argument("--port", type=int, default=5000, help="Port")
    
    subparsers = parser.add_subparsers(dest="command", required=True)
    
    # 'start' command
    subparsers.add_parser("start", help="Trigger a new training session")
    
    # 'retrain' command
    subparsers.add_parser("retrain", help="Trigger a retraining session")
    
    # 'status' command
    subparsers.add_parser("status", help="Check the current training state")

    args = parser.parse_args()

    if args.command == "start":
        handle_train(args.url, args.port)
    elif args.command == "status":
        handle_status(args.url, args.port)
