#!/usr/bin/python3

import argparse
import json
import requests


def print_table(headers, rows):
    """Helper to print a simple formatted table."""
    if not rows:
        print("\nNo results found.")
        return
        
    widths = [len(h) for h in headers]
    for row in rows:
        for i, val in enumerate(row):
            widths[i] = max(widths[i], len(str(val)))
    
    fmt = " | ".join([f"{{:<{w}}}" for w in widths])
    print("\n" + fmt.format(*headers))
    print("-" * (sum(widths) + (3 * (len(headers) - 1))))
    for row in rows:
        print(fmt.format(*row))

def handle_predict(args):
    url = f"{args.url.rstrip('/')}:{args.port}/predict"
    params = {
        "name": args.name, "verb": args.verb, "level": args.level,
        "system": args.system, "attempt": args.attempt, "scenario": args.scenario,
        "audit": args.audit
    }
    
    try:
        resp = requests.get(url, params=params, timeout=10)
        if resp.status_code == 200:
            prob = resp.json().get("success_probability", 0)
            print(f"\nPrediction for {args.name} on {args.system}:")
            print(f"   Success Probability: {prob * 100:.2f}%")
        else:
            print(f"Error ({resp.status_code}): {resp.json().get('error')}")
    except Exception as e:
        print(f"Connection Failed: {e}")

def handle_risk(args):
    url = f"{args.url.rstrip('/')}:{args.port}/rank-risk"
    params = {
        "verb": args.verb, "level": args.level, "system": args.system,
        "attempt": args.attempt, "scenario": args.scenario, "audit": args.audit
    }
    
    # Add limit to params only if specified by user
    if args.limit is not None:
        params["limit"] = args.limit
        print(f"Analyzing top {args.limit} riskiest items for {args.system}...")
    else:
        print(f"Analyzing all riskiest items for {args.system}...")
    
    try:
        # High timeout as this is a heavy operation on the server side
        resp = requests.get(url, params=params, timeout=300)
        if resp.status_code == 200:
            data = resp.json().get("top_high_risk", [])
            rows = [[item['name'], f"{item['prob']*100:.2f}%"] for item in data]
            print_table(["NAME", "PASS PROB"], rows)
            print(f"\nTotal items returned: {len(rows)}")
        else:
            print(f"Error: {resp.text}")
    except Exception as e:
        print(f"Failed: {e}")

def handle_worst_systems(args):
    url = f"{args.url.rstrip('/')}:{args.port}/worst-systems"
    params = {
        "name": args.name, "verb": args.verb, "level": args.level,
        "attempt": args.attempt, "scenario": args.scenario, "audit": args.audit
    }
    
    print(f"Comparing system performance for {args.name}...")
    try:
        resp = requests.get(url, params=params, timeout=60)
        if resp.status_code == 200:
            data = resp.json()
            rows = [[item['system'], f"{item['prob']*100:.2f}%"] for item in data]
            print_table(["SYSTEM", "PASS PROB"], rows)
        else:
            print(f"Error: {resp.text}")
    except Exception as e:
        print(f"Failed: {e}")

def handle_list(args):
    """Fetches metadata via the proxy list endpoint."""
    url = f"{args.url.rstrip('/')}:{args.port}/list/{args.category}"
    
    try:
        resp = requests.get(url, timeout=15)
        if resp.status_code == 200:
            data = resp.json()
            # Handle both raw lists and {"values": [...]} structures
            items = data.get("values", data) if isinstance(data, dict) else data
            
            print(f"\nAvailable {args.category.upper()}:")
            if isinstance(items, list):
                for item in sorted(items):
                    print(f" - {item}")
                print(f"\nTotal: {len(items)}")
            else:
                print(json.dumps(data, indent=4))
        else:
            print(f"Error ({resp.status_code}): {resp.text}")
    except Exception as e:
        print(f"Failed to fetch list: {e}")

def handle_context(args):
    """Fetches prediction PLUS context"""
    url = f"{args.url.rstrip('/')}:{args.port}/predict-with-history"
    params = {
        "name": args.name, "verb": args.verb, "level": args.level,
        "system": args.system, "attempt": args.attempt, "scenario": args.scenario,
        "audit": args.audit
    }
    
    try:
        resp = requests.get(url, params=params, timeout=15)
        if resp.status_code == 200:
            data = resp.json()
            prob = data.get("success_probability", 0)
            history = data.get("history", [])
            
            print(f"\nEXPLORE: {args.name} on {args.system}")
            print(f"Prediction: {prob * 100:.2f}% Success")
            print(f"Context: {len(history)} historical steps found in cache.")
            
            if history:
                rows = []
                for i, entry in enumerate(history):
                    res = "PASS" if entry.get('success') == 1 else "FAIL"

                    rows.append([
                        f"Step -{len(history)-i}",
                        entry.get('start', 'N/A')[:19], # Truncate timestamp
                        f"Atmt {entry.get('attempt', 1)}",
                        res
                    ])
                print_table(["OFFSET", "START TIME", "TRY", "RESULT"], rows)
            else:
                print("No history available for this specific test/system/verb.")
        else:
            print(f"Error ({resp.status_code}): {resp.text}")
    except Exception as e:
        print(f"Connection Failed: {e}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Predictor API Client")
    parser.add_argument("--url", default="http://test-predictor.canonical.com", help="Base URL")
    parser.add_argument("--port", type=int, default=5000, help="Port")

    subparsers = parser.add_subparsers(dest="command", required=True)

    # Predict Command
    p_parser = subparsers.add_parser("predict", help="Predict single item probability")
    p_parser.add_argument("--verb", default="executing")
    p_parser.add_argument("--level", default="task")
    p_parser.add_argument("--attempt", type=int, default=1)
    p_parser.add_argument("--scenario", default="generic")
    p_parser.add_argument("--audit", action="store_true", help="Enable prediction auditing")
    p_parser.add_argument("--name", required=True)
    p_parser.add_argument("--system", required=True)
    

    # Risk Command
    r_parser = subparsers.add_parser("risk", help="List riskiest tests for a system")
    r_parser.add_argument("--verb", default="executing")
    r_parser.add_argument("--level", default="task")
    r_parser.add_argument("--limit", type=int, default=10, help="Number of tests to show (omit for all)")
    r_parser.add_argument("--audit", action="store_true", help="Enable prediction auditing")
    r_parser.add_argument("--attempt", type=int, default=1)
    r_parser.add_argument("--scenario", default="generic")
    r_parser.add_argument("--system", required=True)
    
    # Worst Systems Command
    s_parser = subparsers.add_parser("compare", help="Compare test across all systems")
    s_parser.add_argument("--verb", default="executing")
    s_parser.add_argument("--level", default="task")
    s_parser.add_argument("--attempt", type=int, default=1)
    s_parser.add_argument("--audit", action="store_true", help="Enable prediction auditing")
    s_parser.add_argument("--scenario", default="generic")
    s_parser.add_argument("--name", required=True)

    # List Command
    l_parser = subparsers.add_parser("list", help="List metadata (names, systems, verbs, levels)")
    l_parser.add_argument("category", help="Category to list")

    # Context Command
    c_parser = subparsers.add_parser("context", help="See prediction with historical context")
    c_parser.add_argument("--name", required=True)
    c_parser.add_argument("--system", required=True)
    c_parser.add_argument("--verb", default="executing")
    c_parser.add_argument("--level", default="task")
    c_parser.add_argument("--attempt", type=int, default=1)
    c_parser.add_argument("--scenario", default="generic")
    c_parser.add_argument("--audit", action="store_true")

    args = parser.parse_args()

    if args.command == "predict": 
        handle_predict(args)
    elif args.command == "risk": 
        handle_risk(args)
    elif args.command == "compare": 
        handle_worst_systems(args)
    elif args.command == "list":
        handle_list(args)
    elif args.command == "context":
        handle_context(args)
