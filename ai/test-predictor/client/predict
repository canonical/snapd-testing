#!/usr/bin/python3

import json
import requests
import argparse

def analyze_results(file_path, base_url, port, attempt=None, compare=False):
    predict_url = f"{base_url}:{port}/predict"
    worst_url = f"{base_url}:{port}/worst-systems"

    try:
        with open(file_path, 'r') as f:
            data = json.load(f)
        
        items = data.get("items", [])

        # --- DYNAMIC WIDTH CALCULATION ---
        max_name_len = 50  # Minimum default width
        for item in items:
            name = str(item.get("name", "")).strip()
            variant = str(item.get("variant", "")).strip()
            full_name = f"{name}:{variant}" if variant else name
            if len(full_name) > max_name_len:
                max_name_len = len(full_name)
        
        # Add a little padding for breathing room
        name_width = max_name_len + 2 
        
        print(f"Connecting to: {base_url}:{port}")
        # Use the dynamic width for the header and separator
        print(f"{'NAME':<{name_width}} | {'SYSTEM':<25} | {'SUCCESS PROB'}")
        print("-" * (name_width + 45))

        for item in items:
            verb = item.get("verb", "")
            start = item.get("start")
            end = item.get("end")
            
            if verb == "checking" or not start or not end:
                continue

            if not item.get("success") and not item.get("skipped"):
                level = item.get("level")
                if level in ["task", "suite"]:
                    name = str(item.get("name", "")).strip()
                    variant = str(item.get("variant", "")).strip()
                    full_name = f"{name}:{variant}" if variant else name
                    
                    params = {"name": full_name, "verb": verb, "level": level}
                    if attempt is not None:
                        params["attempt"] = attempt

                    current_system = item.get("system")
                    predict_params = params.copy()
                    predict_params["system"] = current_system

                    try:
                        resp = requests.get(predict_url, params=predict_params, timeout=5)
                        resp.raise_for_status()
                        
                        prob_raw = resp.json().get("success_probability", 0.0)
                        prob_val = float(prob_raw)
                        prob_str = f"{prob_val * 100:6.2f}%"
                        
                        # Apply the dynamic width here as well
                        print(f"{full_name:<{name_width}} | {current_system:<25} | {prob_str}")

                        if compare:
                            worst_resp = requests.get(worst_url, params=params, timeout=20)
                            if worst_resp.status_code == 200:
                                # ... (rest of your existing comparison logic)
                                pass
                        
                    except Exception as e:
                        print(f"Error for {full_name}: {e}")

    except Exception as e:
        print(f"FATAL: {e}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Predict success for failed items.")
    parser.add_argument("file", help="Path to the results JSON file")
    parser.add_argument("--url", default="http://test-predictor.canonical.com", help="Base URL")
    parser.add_argument("--port", type=int, default=5000, help="Port")
    parser.add_argument("--attempt", type=int, help="Optional attempt number")
    parser.add_argument("--compare", action="store_true", help="Compare with other systems")
    
    args = parser.parse_args()
    analyze_results(args.file, args.url.rstrip('/'), args.port, args.attempt, args.compare)
