#!/usr/bin/python3

import json
import requests
import argparse

def analyze_results(file_path, base_url, port, attempt=None, compare=False):
    predict_url = f"{base_url}:{port}/predict"
    worst_url = f"{base_url}:{port}/worst-systems"

    try:
        with open(file_path, 'r') as f:
            data = json.load(f)
            
        items = data.get("items", [])
        
        print(f"Connecting to: {base_url}:{port}")
        print(f"{'NAME':<50} | {'SYSTEM':<20} | {'PROBABILITY'}")
        print("-" * 85)

        for item in items:
            if not item.get("success") and not item.get("skipped"):
                level = item.get("level")
                if level in ["task", "suite"]:
                    # Base parameters
                    params = {
                        "name": item.get("name"),
                        "verb": item.get("verb"),
                        "level": level
                    }
                    if attempt is not None:
                        params["attempt"] = attempt

                    # Get prediction for the SPECIFIC failing system
                    predict_params = params.copy()
                    current_system = item.get("system")
                    predict_params["system"] = current_system

                    try:
                        resp = requests.get(predict_url, params=predict_params, timeout=5)
                        resp.raise_for_status()
                        prob = resp.json().get("success_probability", "N/A")
                        prob_val = prob if isinstance(prob, (float, int)) else 0.0
                        prob_str = f"{prob_val:.4f}" if isinstance(prob, (float, int)) else str(prob)
                        
                        print(f"{predict_params['name'][:48]:<50} | {current_system:<20} | {prob_str}")

                        # Optional Comparison
                        if compare:
                            # Bumped timeout to 20s as fetching ALL systems takes longer
                            worst_resp = requests.get(worst_url, params=params, timeout=20)
                            if worst_resp.status_code == 200:
                                all_systems = worst_resp.json()
                                
                                for s_info in all_systems:
                                    s_name = s_info['system']
                                    s_prob = s_info['prob']
                                    
                                    # Skip the current system to avoid redundancy
                                    if s_name == current_system:
                                        continue
                                        
                                    diff = s_prob - prob_val
                                    symbol = "+" if diff >= 0 else ""
                                    
                                    # Format: indented list of all other known systems
                                    print(f"  ├─ {s_name:<40} | {s_prob:.4f} ({symbol}{diff:+.2f})")
                        
                    except Exception as e:
                        print(f"Error for {params['name']}: {e}")

    except Exception as e:
        print(f"FATAL: {e}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Predict success for failed items.")
    parser.add_argument("file", help="Path to the results JSON file")
    parser.add_argument("--url", default="http://test-predictor.canonical.com", help="Base URL")
    parser.add_argument("--port", type=int, default=5000, help="Port")
    parser.add_argument("--attempt", type=int, help="Optional attempt number")
    parser.add_argument("--compare", action="store_true", help="Compare with other systems to find better alternatives")
    
    args = parser.parse_args()
    base_url = args.url.rstrip('/')
    analyze_results(args.file, base_url, args.port, args.attempt, args.compare)
