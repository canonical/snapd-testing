def handle_cache_clear(args):
    """Clear all cached analyses."""
    url = f"{args.url.rstrip('/')}:{args.port}/cache"
    try:
        resp = requests.delete(url, timeout=args.timeout)
        if resp.status_code != 200:
            print(f"Error ({resp.status_code}): {_error_text(resp)}")
            return
        data = resp.json()
        print(f"\n{data.get('message', 'Cache cleared')}")
    except Exception as e:
        print(f"Connection failed: {e}")


def handle_cache_save(args):
    """Save cache to disk."""
    url = f"{args.url.rstrip('/')}:{args.port}/cache"
    try:
        resp = requests.post(url, timeout=args.timeout)
        if resp.status_code != 200:
            print(f"Error ({resp.status_code}): {_error_text(resp)}")
            return
        data = resp.json()
        print(f"\n{data.get('message', 'Cache saved to disk')}")
    except Exception as e:
        print(f"Connection failed: {e}")



def _base_params(args):
    params = {
        "prob_threshold": args.prob_threshold,
        "lift_threshold": args.lift_threshold,
        "run_granger": str(bool(getattr(args, 'granger', False))).lower(),
        "granger_max_tests": args.granger_max_tests,
        "use_cache": str(not bool(getattr(args, 'no_cache', False))).lower(),
    }
    if getattr(args, 'system', None):
        params["system"] = args.system
    if getattr(args, 'scenario', None):
        params["scenario"] = args.scenario
    return params


def _print_meta(data):
    shape = data.get("matrix_shape", [])
    if shape:
        print(f"\nMatrix: {shape[0]} runs × {shape[1]} tests  |  "
              f"{len(data.get('edges', []))} dependency edges")


