    p_parser.add_argument("--audit", action="store_true", help="Enable prediction auditing")
    p_parser.add_argument("--name", required=True)
    p_parser.add_argument("--system", required=True)

    # Risk Command
    r_parser = subparsers.add_parser("risk", help="List riskiest tests for a system")
    r_parser.add_argument("--verb", default="executing")
    r_parser.add_argument("--limit", type=int, default=10, help="Number of tests to show (omit for all)")
    r_parser.add_argument("--audit", action="store_true", help="Enable prediction auditing")
    r_parser.add_argument("--attempt", type=int)
    r_parser.add_argument("--scenario")
    r_parser.add_argument("--system", required=True)
    
    # Worst Systems Command
    s_parser = subparsers.add_parser("compare", help="Compare test across all systems")
    s_parser.add_argument("--verb", default="executing")
    s_parser.add_argument("--attempt", type=int)
    s_parser.add_argument("--audit", action="store_true", help="Enable prediction auditing")
