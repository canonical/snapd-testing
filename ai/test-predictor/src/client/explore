    parser.add_argument("--port", type=int, default=5000, help="Port")

    subparsers = parser.add_subparsers(dest="command", required=True)

    # Predict Command
    p_parser = subparsers.add_parser("predict", help="Predict single item probability")
    p_parser.add_argument("--verb", default="executing")
    p_parser.add_argument("--attempt", type=int)
