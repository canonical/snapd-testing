    pt_parser.add_argument("--audit", action="store_true")

    t_parser = subparsers.add_parser("test", help="Verify model against synthetic scenarios")
    t_parser.add_argument("--name", default="tests/main/abort")
    t_parser.add_argument("--system", default="ubuntu-24.04-64")
    t_parser.add_argument("--verb", default="executing")
    t_parser.add_argument("--attempt", type=int, default=1)
    t_parser.add_argument("--scenario", default="generic")

    args = parser.parse_args()

    # Mapping commands to functions
    commands = {
        "predict": handle_predict,
        "risk": handle_risk,
        "compare": handle_worst_systems,
        "list": handle_list,
        "context": handle_context,
        "pattern": handle_predict_pattern,
        "test": handle_test_scenarios        
    }
    
    if args.command in commands:
        commands[args.command](args)
