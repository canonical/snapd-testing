    # Context Command
    c_parser = subparsers.add_parser("context", help="See prediction with historical context")
    c_parser.add_argument("--name", required=True)
    c_parser.add_argument("--system", required=True)
    c_parser.add_argument("--verb", default="executing")
    c_parser.add_argument("--attempt", type=int)
    c_parser.add_argument("--scenario")
    c_parser.add_argument("--audit", action="store_true")

    # Pattern Command
    pt_parser = subparsers.add_parser("pattern", help="See prediction with historical context")
    pt_parser.add_argument("--name", required=True)
    pt_parser.add_argument("--system", required=True)
    pt_parser.add_argument("--pattern", required=True, help="Comma-separated string of 0s and 1s")
    pt_parser.add_argument("--verb", default="executing")
