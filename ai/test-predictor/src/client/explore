            prob = resp.json().get("success_probability", 0)
            print(f"\nPrediction for {args.name} on {args.system}:")
            print(f"   Success Probability: {prob * 100:.2f}%")
        else:
            print(f"Error ({resp.status_code}): {resp.json().get('error')}")
    except Exception as e:
        print(f"Connection Failed: {e}")

def handle_test_scenarios(args):
    url = f"{args.url.rstrip('/')}:{args.port}/test"
    params = {
        "name": args.name,
        "system": args.system,
        "verb": args.verb,
        "attempt": args.attempt,
        "scenario": args.scenario
    }
    try:
        resp = requests.get(url, params=params, timeout=10)
        if resp.status_code == 200:
            data = resp.json()
            print("\nMODEL SCENARIO VERIFICATION:")
            rows = []
            for label, info in data.items():
                name = label.upper().replace("_", " ")
                rows.append([name, info["prediction"], info["expected_range"]])
            
            # Now includes the Expected column
            print_table(["SCENARIO", "PREDICTION", "EXPECTED"], rows)
        else:
            print(f"Error: {resp.text}")
    except Exception as e:
        print(f"Connection Failed: {e}")

if __name__ == "__main__":
