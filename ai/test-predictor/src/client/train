#!/usr/bin/python3

import argparse
import json

import requests


def normalize_base_url(raw_url):
    url = (raw_url or "").strip()
    if not url:
        url = "http://test-predictor.snapd.canonical.com"
    if not url.startswith(("http://", "https://")):
        url = f"http://{url}"
    return url.rstrip('/')


def handle_start(base_url, port):
    url = f"{base_url}:{port}/train"
    print(f"Triggering result processing and cache refresh at {url}...")

    try:
        response = requests.post(url, timeout=10)
        if response.status_code in (200, 202):
            print(response.json().get("message", "Cache refresh started."))
        elif response.status_code == 429:
            print("Busy: A cache refresh is already in progress.")
        else:
            print(f"Error ({response.status_code}): {response.text}")
    except requests.exceptions.RequestException as error:
        print(f"Failed to reach the trainer API: {error}")


def handle_status(base_url, port):
    url = f"{base_url}:{port}/status"
    try:
        response = requests.get(url, timeout=5)
        if response.status_code == 200:
            print(json.dumps(response.json(), indent=4))
        else:
            print(f"Could not retrieve status ({response.status_code}): {response.text}")
    except requests.exceptions.RequestException as error:
        print(f"Failed to reach the trainer API: {error}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Control result processing and cache refreshes.")
    parser.add_argument("--url", default="http://test-predictor.snapd.canonical.com", help="Base URL")
    parser.add_argument("--port", type=int, default=5000, help="Port")

    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("start", help="Process pending results and refresh the cache")
    subparsers.add_parser("status", help="Show cache refresh status")

    args = parser.parse_args()
    base_url = normalize_base_url(args.url)

    if args.command == "start":
        handle_start(base_url, args.port)
    else:
        handle_status(base_url, args.port)