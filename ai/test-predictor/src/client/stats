#!/usr/bin/python3

import requests
import argparse

def normalize_base_url(raw_url):
    """
    Ensure the base URL is well-formed, defaulting to http://test-predictor.snapd.canonical.com if empty.
    """
    url = (raw_url or "").strip()
    if not url:
        return "http://test-predictor.snapd.canonical.com"
    if not url.startswith(("http://", "https://")):
        url = f"http://{url}"
    return url.rstrip('/')

def print_table(headers, rows):
    """Helper to print a simple formatted table."""
    if not rows:
        print("\nNo results found.")
        return
    widths = [len(h) for h in headers]
    for row in rows:
        for i, val in enumerate(row):
            widths[i] = max(widths[i], len(str(val)))
    
    fmt = " | ".join([f"{{:<{w}}}" for w in widths])
    print("\n" + fmt.format(*headers))
    print("-" * (sum(widths) + (3 * (len(headers) - 1))))
    for row in rows:
        print(fmt.format(*row))

def build_request(args):
    """Build the stats endpoint URL and non-empty query parameters."""
    base_url = normalize_base_url(args.url)
    filters = {
        "name": args.name,
        "backend": args.backend,
        "attempt": args.attempt,
        "scenario": args.scenario,
        "verb": args.verb,
        "from": args.from_time,
        "to": args.to_time,
    }

    # Select endpoint based on requested mode
    if args.history:
        url = f"{base_url}:{args.port}/stats/history"
        if args.system:
            filters["system"] = args.system
        if args.limit is not None:
            filters["limit"] = args.limit
    elif args.system and args.system.lower() == "all":
        url = f"{base_url}:{args.port}/stats/all-systems"
    else:
        url = f"{base_url}:{args.port}/stats"
        if args.system:
            filters["system"] = args.system

    # Remove None values
    params = {k: v for k, v in filters.items() if v is not None}
    return url, params


def get_audit(args):
    """
    Main function to query the API based on provided arguments and display
    results accordingly.
    """
    base_url = normalize_base_url(args.url)
    url, params = build_request(args)

    try:
        response = requests.get(url, params=params, timeout=120)
        
        if response.status_code != 200:
            print(f"Error ({response.status_code}): {response.text}")
            return

        data = response.json()

        # Handle historical rows for a specific name+system
        if "history" in data:
            history = data.get("history", [])
            rows = []
            for row in history:
                success = row.get("success")
                result = "PASS" if str(success) == "1" else "FAIL"
                rows.append([
                    row.get("start", "N/A"),
                    row.get("attempt", "N/A"),
                    row.get("scenario", "N/A"),
                    row.get("verb", "N/A"),
                    result
                ])

            print(f"\nHISTORY FOR: {args.name} on {args.system}")
            print(f"Records: {data.get('count', len(rows))}")
            print_table(["START", "ATTEMPT", "SCENARIO", "VERB", "RESULT"], rows)

        # Handle 'All Systems' Table View
        elif "systems" in data:
            systems = data["systems"]
            rows = []
            for s_name, stats in sorted(systems.items()):
                p, f, aborted = stats['pass'], stats['fail'], stats.get('aborted', 0)
                total = p + f + aborted
                rate = f"{(p/total*100):.1f}%" if total > 0 else "0%"
                rows.append([s_name, p, f, aborted, total, rate])
            
            print_table(["SYSTEM", "PASS", "FAIL", "ABORTED", "TOTAL", "RATE"], rows)

        # Handle 'Single System' Summary View
        elif "results" in data:
            res = data["results"]
            p, f, aborted, t = res['pass'], res['fail'], res.get('aborted', 0), res['total']
            rate = f"{(p/t*100):.2f}%" if t > 0 else "0%"

            filters_applied = data.get('filters_applied', {})
            target = (
                filters_applied.get('system')
                or filters_applied.get('backend')
                or filters_applied.get('name')
                or 'Unknown'
            )

            print("\n STATS SUMMARY")
            print(f"Target: {target}")
            print("-" * 30)
            print(f"PASS:  {p}")
            print(f"FAIL:  {f}")
            print(f"ABORTED: {aborted}")
            print(f"TOTAL: {t}")
            print(f"RATE:  {rate}")
            if "matching_files" in res:
                print(f"FILES: {res['matching_files']}")

    except requests.exceptions.ConnectionError:
        print(f"Failed to connect to server at {base_url}:{args.port}")
    except Exception as e:
        print(f"Unexpected error: {e}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Audit Client for Historical Test Results")

    # Connection
    parser.add_argument("--url", default="http://test-predictor.snapd.canonical.com", help="API URL")
    parser.add_argument("--port", type=int, default=5000, help="API Port")

    # Filters
    parser.add_argument("--scenario", default="generic")
    parser.add_argument("--verb", choices=("preparing", "executing", "restoring"), help="Limit failures to one phase")
    parser.add_argument("--attempt", type=int)
    parser.add_argument("--backend", help="Backend name")
    parser.add_argument("--system", help="System name or 'all' for breakdown")
    parser.add_argument("--name", help="Test name")
    parser.add_argument("--from", dest="from_time", metavar="YYYY-MM-DD", help="Include results on or after this date")
    parser.add_argument("--to", dest="to_time", metavar="YYYY-MM-DD", help="Include results on or before this date")
    parser.add_argument("--history", action="store_true", help="Return historical rows for --name and --system")
    parser.add_argument("--limit", type=int, help="Limit number of historical rows")

    args = parser.parse_args()

    if args.history and not (args.system and args.name):
        parser.error("--history requires both --system and --name.")
    if not any([args.backend, args.system, args.name, args.attempt, args.scenario, args.verb]):
        parser.error("At least one filter (e.g., --backend or --system all) must be provided.")

    get_audit(args)
