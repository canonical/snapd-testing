def handle_cache_status(base_url, args):
    """Show dependency cache build status and current cache snapshot stats."""
    url = f"{base_url}:{args.port}/dependencies/cache/status"
    try:
        resp = requests.get(url, timeout=args.timeout)
        if resp.status_code != 200:
            print(f"Error ({resp.status_code}): {_error_text(resp)}")
            return

        data = resp.json()
        print("\nCACHE BUILD STATUS")
        print(f"Running: {data.get('running', False)}")
        print(f"Started at: {data.get('started_at')}")
        print(f"Finished at: {data.get('finished_at')}")
        print(f"Processed: {data.get('processed', 0)} / {data.get('total', 0)}")
        print(f"Cached: {data.get('cached', 0)}")
        print(f"No data: {data.get('no_data', 0)}")
        print(f"Failed: {data.get('failed', 0)}")

        errors = data.get('errors', [])
        if errors:
            rows = [
                [e.get('system') or '(none)', e.get('scenario') or '(none)', e.get('error') or '']
                for e in errors[:args.limit]
            ]
            print_table(["SYSTEM", "SCENARIO", "ERROR"], rows)

        cache = data.get('cache', {})
        print("\nCACHE SNAPSHOT")
        print(f"Cached entries: {cache.get('cached_entries', 0)}")
        entries = cache.get('entries', [])
        if entries:
            rows = [
                [
                    e.get('system') or '(none)',
                    e.get('scenario') or '(none)',
                    f"{e.get('age_hours', 0):.2f}h",
                    'STALE' if e.get('stale') else 'FRESH',
                ]
                for e in entries[:args.limit]
            ]
            print_table(["SYSTEM", "SCENARIO", "AGE", "STATUS"], rows)
    except Exception as e:
        print(f"Connection failed: {e}")


