def print_table(headers, rows):
    """ Helper to print a simple formatted table. """
    if not rows:
        print("\nNo results found.")
        return
    widths = [len(h) for h in headers]
    for row in rows:
        for i, val in enumerate(row):
            widths[i] = max(widths[i], len(str(val)))
    fmt = " | ".join([f"{{:<{w}}}" for w in widths])
    print("\n" + fmt.format(*headers))
    print("-" * (sum(widths) + 3 * (len(headers) - 1)))
    for row in rows:
        print(fmt.format(*[str(v) for v in row]))


def _error_text(resp):
    """ Extract error message from response, trying JSON first and falling back to raw text. """
    try:
        data = resp.json()
        if isinstance(data, dict) and "error" in data:
            return data["error"]
        return str(data)
    except Exception:
        return resp.text


def handle_pass_given_fail(base_url, args):
    """
    For a selected failing test A, show P(B passes | A fails) for all other tests B.
    This helps identify tests that are inversely coupled with A.
    """
    url = f"{base_url}:{args.port}/dependencies/pass-given-fail"
    params = {
        "test": args.test,
        "use_cache": str(not bool(getattr(args, 'no_cache', False))).lower(),
        "include_self": str(bool(getattr(args, 'include_self', False))).lower(),
    }
    if getattr(args, 'system', None):
        params["system"] = args.system
    if getattr(args, 'scenario', None):
        params["scenario"] = args.scenario

    try:
        resp = requests.get(url, params=params, timeout=args.timeout)
        if resp.status_code != 200:
            err = _error_text(resp)
            if resp.status_code == 404 and "No data found" in err:
                print("\nNo data found for the given filters.")
                print("Tip: run 'deps ranking' with the same system/scenario and pick a test from that output.")
            else:
                print(f"Error ({resp.status_code}): {err}")
            return

        data = resp.json()
        probabilities = data.get("probabilities", [])

        # Higher score means better discriminatory pairing:
        # many PASS-FAIL cases with comparatively few BOTH-PASS cases.
        for p in probabilities:
            pass_count = p.get("pass_count", 0)
            both_pass_count = p.get("both_pass_count", 0)
            p["pair_score"] = pass_count / (both_pass_count + 1)

        ascending = getattr(args, 'reverse', False)
        if args.sort == "score":
            # Primary: highest pair score; secondary: most PASS-FAIL; tertiary: least BOTH-PASS.
            probabilities = sorted(
                probabilities,
                key=lambda p: (
                    p.get("pair_score", 0.0),
                    p.get("pass_count", 0),
                    -p.get("both_pass_count", 0),
                ),
                reverse=not ascending,
            )
        elif args.sort == "pass-fail":
            probabilities = sorted(
                probabilities,
                key=lambda p: p.get("pass_count", 0),
                reverse=not ascending,
            )
        else:  # pass-pass
            probabilities = sorted(
                probabilities,
                key=lambda p: p.get("both_pass_count", 0),
                reverse=not ascending,
            )

        rows = [
            [
                i + 1,
                p["test"],
                p["pass_count"],
                p.get("both_pass_count", 0),
                f"{p.get('pair_score', 0.0):.4f}",
            ]
            for i, p in enumerate(probabilities[:args.limit])
        ]

        print("\nPASS GIVEN FAIL")
        print(f"Conditioning test: {data.get('conditioning_test', args.test)}")
        print("Count semantics: PASS-FAIL and PASS-PASS are run×instance row counts (not file counts)")
        print("Score formula: PASS-FAIL / (PASS-PASS + 1)")
        print_table([
            "#",
            "TEST",
            "PASS-FAIL",
            "PASS-PASS",
            "SCORE",
        ], rows)
    except Exception as e:
        print(f"Connection failed: {e}")


