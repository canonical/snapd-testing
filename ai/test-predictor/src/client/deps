def handle_cache_build_all(base_url, args):
    """Trigger asynchronous cache build for all system/scenario combinations."""
    url = f"{base_url}:{args.port}/dependencies/cache/build-all"
    try:
        resp = requests.post(url, timeout=args.timeout)
        if resp.status_code not in (200, 202):
            print(f"Error ({resp.status_code}): {_error_text(resp)}")
            return
        data = resp.json()
        print(f"\n{data.get('message', 'Cache build request accepted')}")
        print("Use 'deps cache-status' to track progress.")
    except Exception as e:
        print(f"Connection failed: {e}")


def handle_cache_build(base_url, args):
