    )
    c_status_parser = subparsers.add_parser(
        "cache-status",
        help="Show dependency cache build status",
    )

    c_build_parser.add_argument("--system", required=True,
                        help="Build cache only for this system")

    pgf_parser.add_argument("--test", required=True,
                        help="Conditioning test name A in P(B passes | A fails)")
    pgf_parser.add_argument("--system", help="Filter to a specific system")
    pgf_parser.add_argument("--scenario", default="generic", help="Filter to a specific scenario")
    pgf_parser.add_argument("--include-self", action="store_true",
                        help="Include the conditioning test in output")
    pgf_parser.add_argument(
        "--sort",
        choices=["score", "pass-pass", "pass-fail"],
