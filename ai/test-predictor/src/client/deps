    )
    pgf_parser.add_argument(
        "--reverse",
        action="store_true",
        help="Reverse sort order (ascending instead of descending)",
    )

    fgf_parser.add_argument("--test", required=True,
                        help="Conditioning test name A in P(B fails | A fails)")
    fgf_parser.add_argument("--system", help="Filter to a specific system")
    fgf_parser.add_argument("--scenario", default="generic", help="Filter to a specific scenario")
    fgf_parser.add_argument("--include-self", action="store_true",
                        help="Include the conditioning test in output")
    fgf_parser.add_argument(
        "--sort",
        choices=["fail-prob", "fail-count", "fail-pass", "score", "test"],
        default="score",
        help=(
            "Sort column: 'score' (default), 'fail-prob', 'fail-count', "
            "'fail-pass', 'test'"
        ),
    )
    fgf_parser.add_argument(
        "--reverse",
        action="store_true",
        help="Reverse sort order (ascending instead of descending)",
    )

    args = parser.parse_args()
    base_url = normalize_base_url(args.url)

    {
        "pass-given-fail": handle_pass_given_fail,
        "fail-given-fail": handle_fail_given_fail,
        "cache-build": handle_cache_build,
        "cache-build-all": handle_cache_build_all,
        "cache-status": handle_cache_status,
    }[args.command](base_url, args)
