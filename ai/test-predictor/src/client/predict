#!/usr/bin/python3

import json
import requests
import argparse

def analyze_results(file_path, base_url, port, attempt=None):
    predict_url = f"{base_url}:{port}/predict"

    try:
        with open(file_path, 'r') as f:
            data = json.load(f)
        
        items = data.get("items", [])
        
        # Track if we actually have failures to display
        found_failures = False

        # Dynamic width calculation for NAME based only on failing items
        max_name_len = 30 
        for item in items:
            if not item.get("success") and not item.get("skipped"):
                name = str(item.get("name", "")).strip()
                variant = str(item.get("variant", "")).strip()
                full_name = f"{name}:{variant}" if variant else name
                if len(full_name) > max_name_len:
                    max_name_len = len(full_name)
        
        name_width = max_name_len + 2 
        verb_width = 10
        
        for item in items:
            verb = item.get("verb", "")
            start = item.get("start")
            end = item.get("end")
            
            if verb == "checking" or not start or not end:
                continue

            if not item.get("success") and not item.get("skipped"):
                # Print header once if we find at least one failure
                if not found_failures:
                    print(f"{'NAME':<{name_width}} | {'VERB':<{verb_width}} | {'SYSTEM':<25} | {'SUCCESS PROB'}")
                    print("-" * (name_width + verb_width + 45))
                    found_failures = True

                name = str(item.get("name", "")).strip()
                variant = str(item.get("variant", "")).strip()
                full_name = f"{name}:{variant}" if variant else name
                scenario = str(item.get("scenario", "generic")).strip()

                # Removed 'level' from params
                params = {"name": full_name, "verb": verb, "scenario": scenario}
                if attempt is not None:
                    params["attempt"] = attempt

                current_system = item.get("system")
                predict_params = params.copy()
                predict_params["system"] = current_system

                try:
                    resp = requests.get(predict_url, params=predict_params, timeout=5)
                    resp.raise_for_status()
                    
                    prob_raw = resp.json().get("success_probability", 0.0)
                    prob_val = float(prob_raw)
                    prob_str = f"{prob_val * 100:6.2f}%"
                    
                    print(f"{full_name:<{name_width}} | {verb:<{verb_width}} | {current_system:<25} | {prob_str}")

                except Exception as e:
                    print(f"Error for {full_name}: {e}")

        if not found_failures:
            print("\n No failing tests found.")

    except Exception as e:
        print(f"FATAL: {e}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Predict success for failed items.")
    parser.add_argument("file", help="Path to the results JSON file")
    parser.add_argument("--url", default="http://test-predictor.canonical.com", help="Base URL")
    parser.add_argument("--port", type=int, default=5000, help="Port")
    parser.add_argument("--attempt", type=int, help="Optional attempt number")
    
    args = parser.parse_args()
    # Removed args.compare as it wasn't defined in the parser or used in logic
    analyze_results(args.file, args.url.rstrip('/'), args.port, args.attempt)
