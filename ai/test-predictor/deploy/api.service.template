[Unit]
Description=Gunicorn instance for test-predictor API
After=network.target

[Service]
User={{USER}}
Group=www-data
WorkingDirectory={{HOME}}
Environment="PYTHONUNBUFFERED=1"
Environment="OMP_NUM_THREADS=1"
Environment="MKL_NUM_THREADS=1"
Environment="TF_NUM_INTRAOP_THREADS=1"
Environment="TF_NUM_INTEROP_THREADS=1"
Environment="TF_ENABLE_ONEDNN_OPTS=0"
Environment="PYTHONPATH={{HOME}}/src/common:{{HOME}}/src"
Environment="PATH={{HOME}}/.venv/bin"

ExecStart={{HOME}}/.venv/bin/gunicorn \
    --worker-class gthread \
    --workers 1 \
    --threads 4 \
    --timeout 300 \
    --preload \
    --bind 0.0.0.0:5000 \
    src.services.api.main:app

Restart=always

[Install]
WantedBy=multi-user.target
