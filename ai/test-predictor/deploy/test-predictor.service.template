[Unit]
Description=Gunicorn instance for test-predictor API
After=network.target

[Service]
User={{USER}}
Group=www-data
WorkingDirectory={{HOME}}/test-predictor
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH={{HOME}}/test-predictor/src/common:{{HOME}}/test-predictor/src"
Environment="PATH={{HOME}}/test-predictor/.venv/bin"

# --preload is critical here so workers share the LSTM model in memory
ExecStart={{HOME}}/test-predictor/.venv/bin/gunicorn \
    --workers 3 \
    --timeout 120 \
    --preload \
    --bind 0.0.0.0:5000 \
    src.services.api.main:app


Restart=always

[Install]
WantedBy=multi-user.target
