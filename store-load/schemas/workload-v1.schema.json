{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical.example/schemas/store-load/workload-v1.schema.json",
  "title": "Sanitized Snap Store workload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "requests"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "default_headers": {"$ref": "#/$defs/headers"},
    "clients": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/client"}
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/request"}
    }
  },
  "$defs": {
    "headers": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "$comment": "Runtime validation rejects authorization and cookie headers case-insensitively."
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "weight": {"type": "integer", "minimum": 1, "default": 1},
        "variables": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "method", "path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "method": {"enum": ["GET", "HEAD", "POST"]},
        "path": {"type": "string", "pattern": "^/"},
        "weight": {"type": "integer", "minimum": 1, "default": 1},
        "auth": {"enum": ["none", "device", "user"], "default": "none"},
        "headers": {"$ref": "#/$defs/headers"},
        "body": true
      }
    }
  }
}
